// Prisma schema for Pactum — multi-tenant internal communication SaaS
// for law firms. Each law firm is an Organization (tenant), reachable
// under its own path segment (pactum.app/{slug}/...).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum ChannelType {
  CHANNEL
  DIRECT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum FinanceAccountType {
  REVENUE
  EXPENSE
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  // Path slug, e.g. "meu-escritorio" -> pactum.app/meu-escritorio
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  channels         Channel[]
  invitations      Invitation[]
  financeAccounts  FinanceAccount[]
  financialEntries FinancialEntry[]
  files            FileAttachment[]

  @@map("organizations")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  emailVerified DateTime?
  // Data URL (small, resized client-side) until real object storage
  // (S3/Supabase Storage/etc.) is wired up.
  image         String?
  phone         String?
  title         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships      Membership[]
  accounts         Account[]
  sessions         Session[]
  messages         Message[]
  channelMembers   ChannelMember[]
  sentInvitations  Invitation[]
  financialEntries FinancialEntry[]
  uploadedFiles    FileAttachment[]

  @@map("users")
}

// Joins a User to an Organization with a role. A user can belong to
// more than one law firm tenant (e.g. an external consultant).
model Membership {
  id             String         @id @default(cuid())
  role           MembershipRole @default(MEMBER)
  // Grants access to the Financeiro focus mode regardless of role.
  // OWNER always has access even if this is false.
  financeAccess  Boolean        @default(false)
  createdAt      DateTime       @default(now())
  userId         String
  organizationId String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// Slack-like channel scoped to a single tenant. A DIRECT channel is a
// 1:1 conversation between two members and has no name — the UI shows
// the other participant's name instead.
model Channel {
  id             String      @id @default(cuid())
  type           ChannelType @default(CHANNEL)
  name           String?
  description    String?
  isPrivate      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  organizationId String

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ChannelMember[]
  messages     Message[]

  @@unique([organizationId, name])
  @@index([organizationId, type])
  @@map("channels")
}

model ChannelMember {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  // Last time this member viewed the channel — messages with
  // createdAt <= lastReadAt are "read" by them (used for DM
  // delivered/read receipts).
  lastReadAt DateTime?
  userId     String
  channelId  String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId])
  @@map("channel_members")
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  userId    String
  channelId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@map("messages")
}

// An invite to join an existing Organization. Since there's no email
// delivery wired up yet, the invite link (containing `token`) is shown
// to the inviter to share manually.
model Invitation {
  id             String           @id @default(cuid())
  email          String
  role           MembershipRole   @default(MEMBER)
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  organizationId String
  invitedById    String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("invitations")
}

// Plano de contas: a revenue/expense category financial entries are
// classified under. Named FinanceAccount (not Account) to avoid
// clashing with the Auth.js Account model below.
model FinanceAccount {
  id             String             @id @default(cuid())
  name           String
  type           FinanceAccountType
  createdAt      DateTime           @default(now())
  organizationId String

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      FinancialEntry[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("finance_accounts")
}

// A single revenue or expense entry (lançamento). Revenue entries with
// a past dueDate and no paidAt are overdue receivables (inadimplência).
model FinancialEntry {
  id             String    @id @default(cuid())
  description    String
  amount         Decimal   @db.Decimal(12, 2)
  date           DateTime
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  organizationId String
  accountId      String
  createdById    String

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy    User           @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@map("financial_entries")
}

// Small file storage: content lives as base64 in Postgres for now.
// Fine for an MVP's contracts/PDFs at modest volume, but should move to
// real object storage (S3/Supabase Storage/etc.) before heavy use.
model FileAttachment {
  id             String   @id @default(cuid())
  name           String
  mimeType       String
  size           Int
  data           String
  createdAt      DateTime @default(now())
  organizationId String
  uploadedById   String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("file_attachments")
}

// --- Auth.js (NextAuth) models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
