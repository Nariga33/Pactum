# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/pactum_dev?schema=public"

# Auth.js secret — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-random-secret"

# Do NOT set AUTH_URL/NEXTAUTH_URL here: each law firm tenant is served on
# its own subdomain, so Auth.js must infer the canonical host per request
# (trustHost: true in src/auth.ts) rather than use one fixed origin.

# Root domain tenants are served under: {slug}.{NEXT_PUBLIC_ROOT_DOMAIN}
# In development, lvh.me resolves to 127.0.0.1 (and so do its subdomains).
NEXT_PUBLIC_ROOT_DOMAIN="lvh.me:3000"

# Pusher Channels — powers realtime chat messages. Create a free app at
# https://dashboard.pusher.com/ (Channels product) and copy its keys
# here. Without these set, chat still works but messages only appear to
# other users on page reload (no live push).
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""
