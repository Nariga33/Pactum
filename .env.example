# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/pactum_dev?schema=public"

# Only needed against a pooled connection (e.g. Neon's "-pooler" host on
# Vercel): prisma.config.ts uses this direct/non-pooled URL for
# `prisma migrate deploy`'s advisory lock, which pooled connections
# (PgBouncer transaction mode) don't support. Not needed locally, since
# DATABASE_URL above is already a direct connection.
# DATABASE_URL_UNPOOLED="postgresql://user:password@direct-host:5432/pactum_dev?schema=public"

# Auth.js secret — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-random-secret"

# Do NOT set AUTH_URL/NEXTAUTH_URL here: this lets Auth.js infer the
# canonical host per request (trustHost: true in src/auth.ts), so the app
# works unchanged on any *.vercel.app preview/production URL.

# Pusher Channels — powers realtime chat messages. Create a free app at
# https://dashboard.pusher.com/ (Channels product) and copy its keys
# here. Without these set, chat still works but messages only appear to
# other users on page reload (no live push).
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""
